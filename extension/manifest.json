{
  "manifest_version": 3,
  "name": "Anything Downloader",
  "version": "0.4.1",
  "description": "嗅探网页媒体资源并推送到 Anything Downloader 下载",
  "permissions": [
    "downloads.ui",
    "downloads",
    "webRequest",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anything Downloader",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}