{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anything Downloader",
  "version": "0.4.1",
  "identifier": "com.anythingdownloader.app",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anything Downloader",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "externalBin": [
      "binaries/dl-cli",
      "binaries/dl-server"
    ]
  }
}