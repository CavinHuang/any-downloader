{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anything Downloader",
  "version": "0.4.6",
  "identifier": "com.anythingdownloader.app",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anything Downloader",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "externalBin": [
      "binaries/dl-cli",
      "binaries/dl-server",
      "binaries/yt-dlp",
      "binaries/deno"
    ],
    "resources": {
      "../extension": "extension"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyODlBMUYwNzgwMkZCRkEKUldUNit3SjQ4S0dKSW5NUkdma0JUaVFHNVpJa2EvZmpud3dZY1lRWEJHL3VBd2ZnMkQ0ZHY0RVkK",
      "endpoints": [
        "https://github.com/CavinHuang/any-downloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
